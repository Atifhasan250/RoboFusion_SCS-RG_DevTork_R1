{
  "name": "robofusion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "tsx server.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node scripts/run-with-test-env.mjs npx --no-install vitest run tests/integration",
    "test:concurrency": "node scripts/run-with-test-env.mjs npx --no-install tsx tests/concurrency/concurrent-writes.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:readings": "tsx scripts/seed-readings.ts",
    "db:seed:phantoms": "tsx scripts/seed-phantom-zones.ts",
    "db:indexes:verify": "tsx scripts/verify-indexes.ts",
    "db:indexes:explain": "tsx scripts/explain-indexes.ts",
    "db:integrity:check": "tsx scripts/integrity-check.ts",
    "db:backup": "tsx scripts/backup-mongodb.ts",
    "ml:train": "tsx scripts/train-risk-model.ts",
    "test:ack-race": "node scripts/run-with-test-env.mjs npx --no-install tsx tests/integration/acknowledge-race.ts",
    "test:tc22": "node scripts/run-with-test-env.mjs npx --no-install tsx scripts/tc22-two-zone-incident.ts",
    "test:load": "k6 run tests/load/ingestion.js",
    "db:restore": "tsx scripts/restore-mongodb.ts",
    "db:transactions:verify": "tsx scripts/verify-transactions.ts",
    "verify:all": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "db:seed:verify": "tsx scripts/verify-five-zone-seed.ts",
    "test:edge-load": "node scripts/run-with-test-env.mjs npx --no-install vitest run tests/integration/edge-and-load.test.ts",
    "test:db-suite": "npm run test:integration && npm run test:concurrency && npm run test:ack-race && npm run test:tc22 && npm run test:edge-load",
    "verify:backend": "npm run verify:all && npm run db:seed:verify && npm run db:transactions:verify && npm run db:indexes:verify && npm run db:integrity:check && npm run test:db-suite"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.487.0",
    "mongodb": "^7.5.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "^7.18.1",
    "tw-animate-css": "^1.3.8",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
