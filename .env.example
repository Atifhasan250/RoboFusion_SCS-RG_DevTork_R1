# Official database path: MongoDB Atlas. Put the real URI only in .env (never commit it).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=robofusion
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ZONE_API_KEY_PEPPER=replace-with-a-random-pepper-at-least-16-characters
APP_ORIGIN=http://localhost:3000
APP_ENV=development
DEMO_PASSWORD=scs-grid
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=google/gemini-3.5-flash
AI_TIMEOUT_MS=8000
OFFLINE_AFTER_MS=20000
ML_MODEL_PATH=models/risk-model-v1.json
LOG_LEVEL=info
